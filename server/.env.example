# Copy to server/.env. Do not commit the filled-in file.

PORT=3000
API_KEY=

# Breach email via Brevo SMTP.
# Get the login + SMTP key from https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP login: your Brevo account email or <id>@smtp-brevo.com (shown on the SMTP page)
SMTP_USER=
# SMTP key (this is the SMTP password) — NOT your Brevo API key
SMTP_PASS=
# Must be a verified sender (or on an authenticated domain) in Brevo
SMTP_FROM=

# Port 465 uses implicit TLS. Port 587 uses STARTTLS automatically.
# SMTP_SECURE=1

# Optional: one connection string instead of the fields above, e.g.
# SMTP_URL=smtps://<login>:<smtp-key>@smtp-relay.brevo.com:465
